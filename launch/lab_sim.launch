<?xml version='1.0'?>
<!-- All-in-one: Mahadev's lab world + SVAN M2 + pd_controller + mcp.py + keyboard teleop.
     The robot stands up by itself once spawned; then press 4 (trot) and w/a/s/d in the keyboard window.
     roslaunch mahadev_svan_tasks lab_sim.launch                      (teleop, robot on the orange mat)
     roslaunch mahadev_svan_tasks lab_sim.launch keyboard:=false      (for running my scripts)
     roslaunch mahadev_svan_tasks lab_sim.launch gui:=false           (no Gazebo window, faster)
     roslaunch mahadev_svan_tasks lab_sim.launch circle:=true         (demo: walks laps around the table)
     roslaunch mahadev_svan_tasks lab_sim.launch mcp:=false           (start mcp.py yourself, old 3-terminal way)
     roslaunch mahadev_svan_tasks lab_sim.launch x:=0 y:=-2.3 yaw:=0   (aisle between table and PC counter)
     Camera windows that follow the robot: birdseye:=true pov:=true chase:=false (set any to true/false)
     windows:=false keeps the cameras but opens no image windows (use rqt_image_view instead) -->
<launch>
    <!-- svan_m2_description first (as in gazebo_sim.launch), rest kept so image_transport plugins load -->
    <env name="ROS_PACKAGE_PATH" value="$(find svan_m2_description):$(env ROS_PACKAGE_PATH)"/>
    <env name="GAZEBO_PLUGIN_PATH" value="$(find svan_gazebo)/plugins/build"/>
    <env name="GAZEBO_MODEL_PATH" value="$(find mahadev_svan_tasks)/models:$(optenv GAZEBO_MODEL_PATH)"/>

    <!-- default spawn: on the orange mat, facing along it (+y) -->
    <arg name="x" default="-5.45"/>
    <arg name="y" default="-2.4"/>
    <arg name="z" default="0.45"/>
    <arg name="yaw" default="1.5708"/>
    <arg name="gui" default="true"/>
    <arg name="paused" default="false"/>
    <arg name="keyboard" default="true"/>
    <arg name="mcp" default="true"/>
    <arg name="birdseye" default="true"/>
    <arg name="pov" default="true"/>
    <arg name="chase" default="false"/>
    <arg name="windows" default="true"/>
    <arg name="circle" default="false"/>
    <arg name="views" value="$(eval ','.join(v for v, on in [('birdseye', birdseye), ('pov', pov), ('chase', chase)] if on))"/>

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(find mahadev_svan_tasks)/worlds/mahadev_lab.world"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="verbose" value="true"/>
    </include>

    <param name="robot_description" command="cat $(find svan_m2_description)/urdf/svanm2.urdf"/>
    <node name="quadruped_1" pkg="gazebo_ros" type="spawn_model"
          args="-param robot_description -urdf -x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw) -model svan"/>

    <node name="controller_node" pkg="svan_bringup" type="pd_controller" output="screen"/>

    <!-- motor command publisher (mcp.py, unchanged) - starts once the robot is spawned -->
    <node if="$(arg mcp)" name="motor_command_publisher" pkg="mahadev_svan_tasks" type="mcp_node.py"
          args="$(find svan_control)/src/mcp.py svan" output="screen"/>

    <!-- demo: laps around the conference table (keyboard is left on: 1 / Space stops it only for a moment) -->
    <node if="$(arg circle)" name="circle_table" pkg="mahadev_svan_tasks" type="circle_table.py" output="screen"/>

    <node if="$(arg keyboard)" name="keyboard_interface" pkg="svan_utils" type="keyboard_interface.py" output="screen"/>

    <!-- follow cameras (bird's eye / robot POV / chase) and a window for each -->
    <node if="$(eval views != '')" name="camera_views" pkg="mahadev_svan_tasks" type="camera_views.py" output="screen">
        <param name="views" value="$(arg views)"/>
    </node>
    <node if="$(eval windows and birdseye)" name="view_birdseye" pkg="image_view" type="image_view">
        <remap from="image" to="/mahadev/birdseye/image_raw"/>
        <param name="window_name" value="SVAN - bird's eye"/>
    </node>
    <node if="$(eval windows and pov)" name="view_pov" pkg="image_view" type="image_view">
        <remap from="image" to="/mahadev/pov/image_raw"/>
        <param name="window_name" value="SVAN - robot POV"/>
    </node>
    <node if="$(eval windows and chase)" name="view_chase" pkg="image_view" type="image_view">
        <remap from="image" to="/mahadev/chase/image_raw"/>
        <param name="window_name" value="SVAN - chase cam"/>
    </node>
</launch>
